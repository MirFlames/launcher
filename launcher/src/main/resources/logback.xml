<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- LOG_FILE задаётся в main() до первого getLogger (каталог exe → user.dir → user.home) -->
    <property name="LOG_FILE" value="${LOG_FILE:-launcher.log}"/>
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_FILE}</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%level] %logger{0} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="FILE"/>
    </root>
</configuration>
