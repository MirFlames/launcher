# Backend (обязательны)
BASE_URL=http://localhost:80 # URL по которому доступен backend 
PORT=80 # Порт который слушает backend
FILES_PATH=./files # Путь к директории с файлами для раздачи
TELEGRAM_BOT_TOKEN= # Токен телеграм бота для аутентификации
TELEGRAM_BOT_USERNAME= # Имя телеграм бота для аутентификации
TELEGRAM_REQUIRED_CHANNEL= # Канал для обязательной подписки
SERVER_HOST=localhost # IP адрес майнкрафт сервера
SERVER_PORT=25565 # Порт майнкрафт сервера

# Launcher build (подпись)
CODESIGN_PFX=%USERPROFILE%\codesign.pfx # Путь к файлу с подписью
CODESIGN_PASSWORD=your-pfx-password # Пароль к файлу с подписью

# Mods (при сборке)
AUTH_API_URL=http://localhost:80 # URL по которому доступен backend для аутентификации
